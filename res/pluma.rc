#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "pluma_version.h"

// Application Manifest is handled by CMake target_sources
 
// Icons
IDI_APP_ICON    ICON    "icons/app.ico"
IDI_DOC_MD      ICON    "icons/doc_md.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     PLUMA_VERSION_MAJOR,PLUMA_VERSION_MINOR,PLUMA_VERSION_PATCH,0
PRODUCTVERSION  PLUMA_VERSION_MAJOR,PLUMA_VERSION_MINOR,PLUMA_VERSION_PATCH,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Mauricio Bridge"
            VALUE "FileDescription",  "Pluma - Editor Markdown nativo para Windows"
            VALUE "FileVersion",      PLUMA_VERSION_RC
            VALUE "InternalName",     "pluma"
            VALUE "OriginalFilename", "pluma.exe"
            VALUE "ProductName",      "Pluma"
            VALUE "ProductVersion",   PLUMA_VERSION_RC
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Accelerator Table
IDR_ACCELERATOR ACCELERATORS
BEGIN
    "N",            IDM_FILE_NEW,           VIRTKEY, CONTROL
    "O",            IDM_FILE_OPEN,          VIRTKEY, CONTROL
    "S",            IDM_FILE_SAVE,          VIRTKEY, CONTROL
    "S",            IDM_FILE_SAVEAS,        VIRTKEY, CONTROL, SHIFT
    "Z",            IDM_EDIT_UNDO,          VIRTKEY, CONTROL
    "Y",            IDM_EDIT_REDO,          VIRTKEY, CONTROL
    "F",            IDM_EDIT_FIND,          VIRTKEY, CONTROL
    "H",            IDM_EDIT_REPLACE,       VIRTKEY, CONTROL
    "G",            IDM_EDIT_GOTO,          VIRTKEY, CONTROL
    "Z",            IDM_EDIT_WRAP,          VIRTKEY, ALT
    "1",            IDM_VIEW_EDITOR_ONLY,   VIRTKEY, CONTROL
    "2",            IDM_VIEW_SPLIT,         VIRTKEY, CONTROL
    "3",            IDM_VIEW_PREVIEW_ONLY,  VIRTKEY, CONTROL
    "B",            IDM_FORMAT_BOLD,        VIRTKEY, CONTROL
    "I",            IDM_FORMAT_ITALIC,      VIRTKEY, CONTROL
    "K",            IDM_FORMAT_LINK,        VIRTKEY, CONTROL
    "C",            IDM_FORMAT_CODE,        VIRTKEY, CONTROL, SHIFT
    "X",            IDM_FORMAT_STRIKE,      VIRTKEY, CONTROL, SHIFT
    "O",            IDM_VIEW_OUTLINE,       VIRTKEY, CONTROL, SHIFT
    "E",            IDM_VIEW_OUTLINE_PANEL, VIRTKEY, CONTROL, SHIFT
    "F",            IDM_VIEW_EXPLORER_PANEL, VIRTKEY, CONTROL, SHIFT
    VK_OEM_COMMA,   IDM_SETTINGS_PREFERENCES, VIRTKEY, CONTROL
END

// Menu (Spanish Default)
LANGUAGE LANG_SPANISH, SUBLANG_DEFAULT
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",               IDM_FILE_NEW
        MENUITEM "&Abrir...\tCtrl+O",            IDM_FILE_OPEN
        MENUITEM "&Guardar\tCtrl+S",             IDM_FILE_SAVE
        MENUITEM "Guardar &como...\tCtrl+Shift+S", IDM_FILE_SAVEAS
        MENUITEM SEPARATOR
        POPUP "&Exportar"
        BEGIN
            MENUITEM "Exportar a &HTML...",      IDM_FILE_EXPORT_HTML
            MENUITEM "Exportar a &PDF...",       IDM_FILE_EXPORT_PDF
        END
        MENUITEM SEPARATOR
        MENUITEM "&Salir",                       IDM_FILE_EXIT
    END
    POPUP "&Edición"
    BEGIN
        MENUITEM "&Deshacer\tCtrl+Z",            IDM_EDIT_UNDO
        MENUITEM "&Rehacer\tCtrl+Y",             IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cor&tar\tCtrl+X",              IDM_EDIT_CUT
        MENUITEM "&Copiar\tCtrl+C",              IDM_EDIT_COPY
        MENUITEM "&Pegar\tCtrl+V",               IDM_EDIT_PASTE
        MENUITEM "&Seleccionar todo\tCtrl+A",    IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "&Buscar...\tCtrl+F",           IDM_EDIT_FIND
        MENUITEM "&Reemplazar...\tCtrl+H",       IDM_EDIT_REPLACE
        MENUITEM "&Ir a línea...\tCtrl+G",       IDM_EDIT_GOTO
        MENUITEM SEPARATOR
        POPUP "&Formato"
        BEGIN
            MENUITEM "&Negrita\tCtrl+B",         IDM_FORMAT_BOLD
            MENUITEM "&Cursiva\tCtrl+I",         IDM_FORMAT_ITALIC
            MENUITEM "&Código\tCtrl+Shift+C",    IDM_FORMAT_CODE
            MENUITEM "&Tachado\tCtrl+Shift+X",   IDM_FORMAT_STRIKE
            MENUITEM "&Enlace...\tCtrl+K",       IDM_FORMAT_LINK
        END
        MENUITEM SEPARATOR
        MENUITEM "A&juste de línea\tAlt+Z",      IDM_EDIT_WRAP
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "Solo &editor\tCtrl+1",         IDM_VIEW_EDITOR_ONLY
        MENUITEM "Vista &dividida\tCtrl+2",      IDM_VIEW_SPLIT
        MENUITEM "Solo vista &previa\tCtrl+3",   IDM_VIEW_PREVIEW_ONLY
        MENUITEM SEPARATOR
        POPUP "&Tema"
        BEGIN
            MENUITEM "&Automático (Sistema)",   IDM_VIEW_THEME_SYSTEM
            MENUITEM "Modo &oscuro",            IDM_VIEW_THEME_DARK
            MENUITEM "Modo &claro",             IDM_VIEW_THEME_LIGHT
        END
        MENUITEM SEPARATOR
        MENUITEM "&Panel de encabezados\tCtrl+Shift+E", IDM_VIEW_OUTLINE_PANEL
        MENUITEM "&Explorador de archivos\tCtrl+Shift+F", IDM_VIEW_EXPLORER_PANEL
        MENUITEM "&Barra de herramientas",       IDM_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",             IDM_VIEW_STATUSBAR
        MENUITEM "&Esquema de encabezados...\tCtrl+Shift+O", IDM_VIEW_OUTLINE
    END
    POPUP "&Configuración"
    BEGIN
        MENUITEM "&Preferencias...\tCtrl+,",     IDM_SETTINGS_PREFERENCES
        MENUITEM SEPARATOR
        MENUITEM "Establecer como editor pre&determinado de Markdown...", IDM_SETTINGS_DEFAULT_EDITOR
    END
    POPUP "A&yuda"
    BEGIN
        MENUITEM "Buscar &actualizaciones...",   IDM_HELP_CHECK_UPDATES
        MENUITEM SEPARATOR
        MENUITEM "&Acerca de Pluma...",          IDM_HELP_ABOUT
    END
END

// Preferences dialog
LANGUAGE LANG_SPANISH, SUBLANG_DEFAULT
IDD_SETTINGS DIALOGEX 0, 0, 420, 272
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preferencias"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Left column: appearance and editor
    LTEXT           "Apariencia", IDC_SET_HEADER_APPEARANCE, 12, 8, 188, 10
    LTEXT           "Tema:", IDC_STATIC, 12, 24, 78, 8
    COMBOBOX        IDC_SET_THEME, 92, 22, 108, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Fuente del editor:", IDC_STATIC, 12, 40, 78, 8
    COMBOBOX        IDC_SET_FONT, 92, 38, 108, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tamaño de fuente:", IDC_STATIC, 12, 56, 78, 8
    COMBOBOX        IDC_SET_FONTSIZE, 92, 54, 50, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Zoom de vista previa:", IDC_STATIC, 12, 72, 78, 8
    COMBOBOX        IDC_SET_ZOOM, 92, 70, 50, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Editor", IDC_SET_HEADER_EDITOR, 12, 94, 188, 10
    CONTROL         "&Ajuste de línea", IDC_SET_WORDWRAP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 108, 188, 10
    CONTROL         "Mostrar &números de línea", IDC_SET_LINENUMBERS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 120, 188, 10
    CONTROL         "Resaltar &la línea actual", IDC_SET_CURRENTLINE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 132, 188, 10
    CONTROL         "Insertar &tabulaciones en lugar de espacios", IDC_SET_USETABS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 144, 188, 10
    LTEXT           "Ancho de tabulación:", IDC_STATIC, 12, 160, 78, 8
    COMBOBOX        IDC_SET_TABWIDTH, 92, 158, 50, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Fin de línea (nuevos):", IDC_STATIC, 12, 176, 78, 8
    COMBOBOX        IDC_SET_EOL, 92, 174, 108, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // Right column: window, view and export
    LTEXT           "Ventana y vista", IDC_SET_HEADER_VIEW, 220, 8, 188, 10
    LTEXT           "Vista al iniciar:", IDC_STATIC, 220, 24, 80, 8
    COMBOBOX        IDC_SET_STARTVIEW, 302, 22, 106, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Mostrar el panel de &encabezados", IDC_SET_OUTLINE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 40, 188, 10
    CONTROL         "Mostrar la &barra de estado", IDC_SET_STATUSBAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 52, 188, 10
    CONTROL         "Desplazamiento &sincronizado editor / vista previa", IDC_SET_SYNCSCROLL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 64, 188, 10
    CONTROL         "Recordar tamaño y posición de la &ventana", IDC_SET_REMEMBERWINDOW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 76, 188, 10
    CONTROL         "Reabrir el último &documento al iniciar", IDC_SET_REOPENLAST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 88, 188, 10

    LTEXT           "Exportación", IDC_SET_HEADER_EXPORT, 220, 110, 188, 10
    LTEXT           "Tamaño de página PDF:", IDC_STATIC, 220, 126, 80, 8
    COMBOBOX        IDC_SET_PDFPAGE, 302, 124, 106, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Márgenes del PDF:", IDC_STATIC, 220, 142, 80, 8
    COMBOBOX        IDC_SET_PDFMARGIN, 302, 140, 50, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tema del HTML:", IDC_STATIC, 220, 158, 80, 8
    COMBOBOX        IDC_SET_HTMLTHEME, 302, 156, 106, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // Windows integration
    LTEXT           "Integración con Windows", IDC_SET_HEADER_WINDOWS, 12, 198, 396, 10
    LTEXT           "", IDC_SET_ASSOC_STATUS, 12, 214, 250, 8
    PUSHBUTTON      "Establecer como &predeterminado...", IDC_SET_ASSOC_BUTTON, 268, 211, 140, 14
    CONTROL         "Buscar act&ualizaciones automáticamente al iniciar", IDC_SET_CHECKUPDATES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 230, 250, 10

    PUSHBUTTON      "&Restablecer valores", IDC_SET_RESET, 12, 250, 90, 14
    DEFPUSHBUTTON   "Aceptar", IDOK, 248, 250, 50, 14
    PUSHBUTTON      "Cancelar", IDCANCEL, 302, 250, 50, 14
    PUSHBUTTON      "Apl&icar", IDC_SET_APPLY, 356, 250, 52, 14
END

// String Tables (Spanish)
LANGUAGE LANG_SPANISH, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    IDS_APP_TITLE               "Pluma"
    IDS_UNTITLED                "Sin título"
    IDS_SAVE_CHANGES_PROMPT     "¿Desea guardar los cambios en %s?"
    IDS_FILTER_MARKDOWN         "Archivos Markdown (*.md;*.markdown;*.mdown)\0*.md;*.markdown;*.mdown\0"
    IDS_FILTER_ALL              "Todos los archivos (*.*)\0*.*\0"
    IDS_FILTER_HTML             "Documento HTML (*.html;*.htm)\0*.html;*.htm\0"
    IDS_FILTER_PDF              "Documento PDF (*.pdf)\0*.pdf\0"
END
